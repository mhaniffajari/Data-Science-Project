---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	generate(generate)
	criteria(criteria)
	improve(improve)
	final(final)
	__end__([<p>__end__</p>]):::last
	__start__ --> generate;
	criteria -. &nbsp;Passed&nbsp; .-> final;
	criteria -. &nbsp;Failed&nbsp; .-> improve;
	generate --> criteria;
	improve --> criteria;
	final --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
